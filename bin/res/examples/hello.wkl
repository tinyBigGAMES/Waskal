  hello.wkl
  Hello-world demo. Minimal exe module with emoji output.
*******************************************************************************/

module exe hello;

@favicon "$P:res/assets/icons/waskal.ico";

begin
  println("Hello, I am %s! 🚀🔥✨", "Waskal");
  
  var i: int32 = 0;
  var s: string = "Waskal™ " + "Programming Language";
  
  println(s);
  
  for i := 1 to 10 do
    println("%d", i);
  end
end.
