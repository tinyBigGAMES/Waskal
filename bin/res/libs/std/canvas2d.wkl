// ---- Wrappers (non-extern) ----

// measureText into a caller record
public routine MeasureText(const text: string; var m: TextMetrics);
begin
  MeasureTextInto(text, address of m);
end;

// getTransform into a caller record
public routine GetTransform(var m: Matrix);
begin
  GetTransformInto(address of m);
end;

// canvas.toDataURL -> Waskal string (length query, allocate, fill, copy)
public routine ToDataURL(const mime: string): string;
var 
  needed: int64;
  buf: ptr to char;
  s: string;
begin
  needed := ToDataURLInto(mime, nil, 0);
  getmem(buf);
  resizemem(buf, needed + 1);
  ToDataURLInto(mime, buf, needed + 1);
  s := buf;
  freemem(buf);
  return s;
end;

// Text drawing-style getter -> Waskal string (same length-query dance as ToDataURL)
routine GetTextProp(const id: int32): string;
var
  needed: int64;
  buf: ptr to char;
  s: string;
begin
  needed := GetTextPropInto(id, nil, 0);
  getmem(buf);
  resizemem(buf, needed + 1);
  GetTextPropInto(id, buf, needed + 1);
  s := buf;
  freemem(buf);
  return s;
end;

public routine GetFont(): string;
begin
  return GetTextProp(TEXT_PROP_FONT);
end;

public routine GetTextAlign(): string;
begin
  return GetTextProp(TEXT_PROP_TEXT_ALIGN);
end;

public routine GetTextBaseline(): string;
begin
  return GetTextProp(TEXT_PROP_TEXT_BASELINE);
end;

public routine GetDirection(): string;
begin
  return GetTextProp(TEXT_PROP_DIRECTION);
end;

public routine GetLetterSpacing(): string;
begin
  return GetTextProp(TEXT_PROP_LETTER_SPACING);
end;

public routine GetWordSpacing(): string;
begin
  return GetTextProp(TEXT_PROP_WORD_SPACING);
end;

public routine GetFontKerning(): string;
begin
  return GetTextProp(TEXT_PROP_FONT_KERNING);
end;

public routine GetFontStretch(): string;
begin
  return GetTextProp(TEXT_PROP_FONT_STRETCH);
end;

public routine GetFontVariantCaps(): string;
begin
  return GetTextProp(TEXT_PROP_FONT_VARIANT_CAPS);
end;

public routine GetTextRendering(): string;
begin
  return GetTextProp(TEXT_PROP_TEXT_RENDERING);
end;

// Convenience API (kept for the existing demos; int32 pixel coords, RGB ints)
public routine Clear(const r: int32; const g: int32; const b: int32);
begin
  SetFillRGB(r, g, b);
  FillRect(0.0, 0.0, float64(Width()), float64(Height()));
end;

public routine Rect(const x: int32; const y: int32; const w: int32; const h: int32; const r: int32; const g: int32; const b: int32);
begin
  SetFillRGB(r, g, b);
  FillRect(float64(x), float64(y), float64(w), float64(h));
end;

public routine Circle(const x: int32; const y: int32; const radius: int32; const r: int32; const g: int32; const b: int32);
begin
  SetFillRGB(r, g, b);
  BeginPath();
  Arc(float64(x), float64(y), float64(radius), 0.0, 6.283185307179586, false);
  Fill();
end;

public routine Line(const x1: int32; const y1: int32; const x2: int32; const y2: int32; const r: int32; const g: int32; const b: int32; const width: int32);
begin
  SetStrokeRGB(r, g, b);
  SetLineWidth(float64(width));
  BeginPath();
  MoveTo(float64(x1), float64(y1));
  LineTo(float64(x2), float64(y2));
  Stroke();
end;

public routine DrawImage(const asset: string; const x: int32; const y: int32; const w: int32; const h: int32);
begin
  DrawImageSize(asset, float64(x), float64(y), float64(w), float64(h));
end;

end.
