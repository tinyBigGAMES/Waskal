  canvas2d.wkl

  Wraps the canvas2d.js shim (HTML5 Canvas 2D). Geometry is float64, sizes
  and handles int32, colours/fonts/enums are CSS strings. Handle 0 = none.
  Image sources are embedded assets by name.
*******************************************************************************/

module unit canvas2d;

public type
  // JS object handles (int32 indexes into the shim's handle tables)
  Gradient = int32;
  Pattern = int32;
  Path = int32;
  ImageData = int32;

  // measureText() result -- 12 float64 fields, this exact order and layout
  // is what MeasureTextInto writes (8 bytes each, little-endian)
  TextMetrics = record
    width: float64;
    actualBoundingBoxLeft: float64;
    actualBoundingBoxRight: float64;
    actualBoundingBoxAscent: float64;
    actualBoundingBoxDescent: float64;
    fontBoundingBoxAscent: float64;
    fontBoundingBoxDescent: float64;
    emHeightAscent: float64;
    emHeightDescent: float64;
    hangingBaseline: float64;
    alphabeticBaseline: float64;
    ideographicBaseline: float64;
  end;

  // getTransform() result -- DOMMatrix a..f, 6 float64
  Matrix = record
    a: float64;
    b: float64;
    c: float64;
    d: float64;
    e: float64;
    f: float64;
  end;

public const
  // lineCap
  LINE_CAP_BUTT = "butt";
  LINE_CAP_ROUND = "round";
  LINE_CAP_SQUARE = "square";
  // lineJoin
  LINE_JOIN_MITER = "miter";
  LINE_JOIN_ROUND = "round";
  LINE_JOIN_BEVEL = "bevel";
  // fill rules
  FILL_RULE_NON_ZERO = "nonzero";
  FILL_RULE_EVEN_ODD = "evenodd";
  // textAlign
  TEXT_ALIGN_START = "start";
  TEXT_ALIGN_END = "end";
  TEXT_ALIGN_LEFT = "left";
  TEXT_ALIGN_RIGHT = "right";
  TEXT_ALIGN_CENTER = "center";
  // textBaseline
  BASELINE_TOP = "top";
  BASELINE_HANGING = "hanging";
  BASELINE_MIDDLE = "middle";
  BASELINE_ALPHABETIC = "alphabetic";
  BASELINE_IDEOGRAPHIC = "ideographic";
  BASELINE_BOTTOM = "bottom";
  // direction
  DIRECTION_LTR = "ltr";
  DIRECTION_RTL = "rtl";
  DIRECTION_INHERIT = "inherit";
  // fontKerning
  KERNING_AUTO = "auto";
  KERNING_NORMAL = "normal";
  KERNING_NONE = "none";
  // fontStretch
  STRETCH_ULTRA_CONDENSED = "ultra-condensed";
  STRETCH_EXTRA_CONDENSED = "extra-condensed";
  STRETCH_CONDENSED = "condensed";
  STRETCH_SEMI_CONDENSED = "semi-condensed";
  STRETCH_NORMAL = "normal";
  STRETCH_SEMI_EXPANDED = "semi-expanded";
  STRETCH_EXPANDED = "expanded";
  STRETCH_EXTRA_EXPANDED = "extra-expanded";
  STRETCH_ULTRA_EXPANDED = "ultra-expanded";
  // fontVariantCaps
  VARIANT_CAPS_NORMAL = "normal";
  VARIANT_CAPS_SMALL = "small-caps";
  VARIANT_CAPS_ALL_SMALL = "all-small-caps";
  VARIANT_CAPS_PETITE = "petite-caps";
  VARIANT_CAPS_ALL_PETITE = "all-petite-caps";
  VARIANT_CAPS_UNICASE = "unicase";
  VARIANT_CAPS_TITLING = "titling-caps";
  // textRendering
  RENDERING_AUTO = "auto";
  RENDERING_OPTIMIZE_SPEED = "optimizeSpeed";
  RENDERING_OPTIMIZE_LEGIBILITY = "optimizeLegibility";
  RENDERING_GEOMETRIC_PRECISION = "geometricPrecision";
  // SetPlacement
  PLACE_FLOW = "flow";
  PLACE_CENTER = "center";
  PLACE_FILL = "fill";
  PLACE_WINDOW = "window";
  // GetTextPropInto ids -- must match _TEXT_PROPS order in canvas2d.js
  TEXT_PROP_FONT = 0;
  TEXT_PROP_TEXT_ALIGN = 1;
  TEXT_PROP_TEXT_BASELINE = 2;
  TEXT_PROP_DIRECTION = 3;
  TEXT_PROP_LETTER_SPACING = 4;
  TEXT_PROP_WORD_SPACING = 5;
  TEXT_PROP_FONT_KERNING = 6;
  TEXT_PROP_FONT_STRETCH = 7;
  TEXT_PROP_FONT_VARIANT_CAPS = 8;
  TEXT_PROP_TEXT_RENDERING = 9;
  // imageSmoothingQuality
  SMOOTHING_LOW = "low";
  SMOOTHING_MEDIUM = "medium";
  SMOOTHING_HIGH = "high";
  // globalCompositeOperation (26)
  COMPOSITE_SOURCE_OVER = "source-over";
  COMPOSITE_SOURCE_IN = "source-in";
  COMPOSITE_SOURCE_OUT = "source-out";
  COMPOSITE_SOURCE_ATOP = "source-atop";
  COMPOSITE_DESTINATION_OVER = "destination-over";
  COMPOSITE_DESTINATION_IN = "destination-in";
  COMPOSITE_DESTINATION_OUT = "destination-out";
  COMPOSITE_DESTINATION_ATOP = "destination-atop";
  COMPOSITE_LIGHTER = "lighter";
  COMPOSITE_COPY = "copy";
  COMPOSITE_XOR = "xor";
  COMPOSITE_MULTIPLY = "multiply";
  COMPOSITE_SCREEN = "screen";
  COMPOSITE_OVERLAY = "overlay";
  COMPOSITE_DARKEN = "darken";
  COMPOSITE_LIGHTEN = "lighten";
  COMPOSITE_COLOR_DODGE = "color-dodge";
  COMPOSITE_COLOR_BURN = "color-burn";
  COMPOSITE_HARD_LIGHT = "hard-light";
  COMPOSITE_SOFT_LIGHT = "soft-light";
  COMPOSITE_DIFFERENCE = "difference";
  COMPOSITE_EXCLUSION = "exclusion";
  COMPOSITE_HUE = "hue";
  COMPOSITE_SATURATION = "saturation";
  COMPOSITE_COLOR = "color";
  COMPOSITE_LUMINOSITY = "luminosity";

// ---- Setup / canvas element ----
// All sizes and coordinates are logical (CSS) pixels. The backing store is
// logical * devicePixelRatio so drawing is crisp on high-DPI displays; the
// user never sees the ratio. ImageData positions and sizes are logical too;
// only the pixel buffer is dpr-dense (ImageDataWidth/Height report it).
public routine Init(const w: int32; const h: int32);
  external "canvas2d" name "Init";
public routine InitOn(const id: ptr to char; const w: int32; const h: int32): bool;
  external "canvas2d" name "InitOn";
public routine Resize(const w: int32; const h: int32);
  external "canvas2d" name "Resize";
public routine Width(): int32;
  external "canvas2d" name "Width";
public routine Height(): int32;
  external "canvas2d" name "Height";
// Browser viewport size in CSS pixels (window.innerWidth/innerHeight).
public routine ViewportWidth(): int32;
  external "canvas2d" name "ViewportWidth";
public routine ViewportHeight(): int32;
  external "canvas2d" name "ViewportHeight";
public routine SetBackground(const css: ptr to char);
  external "canvas2d" name "SetBackground";
// PLACE_FLOW   in the page flow with the dev console (default)
// PLACE_CENTER app mode, centred, logical size unchanged
// PLACE_FILL   app mode, scaled to the window keeping aspect (letterboxed),
//              logical size unchanged -- draw in Init() pixels (games)
// PLACE_WINDOW app mode, logical size follows the window automatically --
//              read Width()/Height() each frame (apps)
public routine SetPlacement(const mode: ptr to char);
  external "canvas2d" name "SetPlacement";
routine ToDataURLInto(const mime: ptr to char; const buf: ptr to char; const bufSize: int64): int64;
  external "canvas2d" name "ToDataURL";

