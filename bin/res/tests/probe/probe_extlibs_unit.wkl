module exe probe_extlibs_unit;

import extlibs;

var
  r: int64;
begin
  println("JsAdd(2, 3) = %d", extlibs.JsAdd(2, 3));
  r := extlibs.Add(10, 20);
  println("Add(10, 20) = %d", r);
end.
